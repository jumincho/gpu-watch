{
  "poll_interval_seconds": 10,
  "ssh_timeout_seconds": 8,
  "ssh_gpu_probe_timeout_seconds": 45,
  "ssh_disk_probe_timeout_seconds": 720,
  "remote_probe_command_timeout_seconds": 8,
  "docker_usage_timeout_seconds": 30,
  "collector_workers": 8,
  "disk_poll_interval_seconds": 1800,
  "disk_du_timeout_seconds": 600,
  "disk_probe_workers": 2,
  "busy_memory_threshold_mib": 500,
  "busy_utilization_threshold_percent": 10,
  "activity_policy": {
    "hot_server_busy_fraction": 0.5,
    "cold_idle_days": 7,
    "cold_min_session_seconds": 60
  },
  "event_retention_days": 180,
  "announcement_retention_days": 90,
  "backup_retention_days": 14,
  "predeployment_backup_retention_days": 30,
  "daily_index_retention_days": 180,
  "raw_interval_retention_days": 8,
  "maintenance_initial_delay_seconds": 120,
